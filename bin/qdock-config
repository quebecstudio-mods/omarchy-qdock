#!/bin/bash

# Sets one of qDock's settings in its entry under "plugins" in shell.json, the
# way `omarchy dock` sets the dock's own. A null value removes the setting.
# Usage: qdock-config <key> <json-value>

set -euo pipefail

source omarchy-shell-config

(( $# == 2 )) || fail "usage: qdock-config <key> <json-value>"
[[ $1 =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || fail "invalid setting name: $1"

commit '
  def entry: type == "object" and .id == $id;
  def apply: if $value == null then del(.[$key]) else .[$key] = $value end;
  .plugins = ((.plugins // []) as $list
    | if any($list[]; entry)
      then $list | map(if entry then apply else . end)
      else $list + [{ id: $id } | apply]
      end)
' --arg id quebecstudio.qdock --arg key "$1" --argjson value "$2"
